# -----------------------------------------------------------------------------
# Attack-simulation artifacts — PCAPs, namespace state, traffic captures
# -----------------------------------------------------------------------------
# These are produced by src/attacks/* and are never committed because
# (a) they are large, (b) they may contain traffic patterns that should not
# be distributed without review, and (c) every result that depends on them
# is reproducible from the seeds in configs/attack_suite_params.yaml.

artifacts/
artifacts/*.pcap
artifacts/*.pcapng
artifacts/*.cap
artifacts/*.netns
pcap/
*.pcap
*.pcapng
*.cap
*.erf
*.snoop


# -----------------------------------------------------------------------------
# Network-namespace scratch state (from src/attacks/*)
# -----------------------------------------------------------------------------
# The attack simulations create short-lived network namespaces via `ip netns`.
# The kernel cleans these up on process exit, but if a run is killed mid-way,
# the scratch files may linger. They are never committed.

/var/run/netns/
/run/netns/
*.netns.lock


