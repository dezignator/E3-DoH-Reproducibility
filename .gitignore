# =============================================================================
# DELIBERATE NON-IGNORES — these MUST remain committed
# =============================================================================
#
# The following are explicitly NOT ignored. If any of them appears in a
# git status output after a run, that is a signal that something is wrong
# with the run, not that the .gitignore is wrong.
#
#   configs/*.yaml          : every configuration file is committed
#   configs/schema.json     : config schema, committed
#   expected_outputs/*.json : reference values, committed
#   expected_outputs/*.csv  : reference values, committed
#   expected_outputs/*.png  : reference figures, committed
#   expected_outputs/*.svg  : reference figures, committed
#   expected_outputs/MANIFEST.sha256 : committed
#   expected_outputs/verification_script.py : committed
#   data/attack_matrix.csv  : the 15-scenario attack corpus, committed
#   data/download_datasets.py : committed
#   tests/fixtures/*        : small test fixtures, committed
#   scripts/**              : committed
#   src/**                  : committed
#
# The negation patterns below are belt-and-braces: they make the intent
# explicit and prevent a broad ignore from accidentally swallowing a
# committed file.

!configs/
!configs/*.yaml
!configs/schema.json
!expected_outputs/
!expected_outputs/*.json
!expected_outputs/*.csv
!expected_outputs/*.png
!expected_outputs/*.svg
!expected_outputs/MANIFEST.sha256
!expected_outputs/verification_script.py
!data/
!data/attack_matrix.csv
!data/download_datasets.py
!data/data_utils.py
!data/preprocess_zenodo.py
!data/preprocess_pcap.py
!src/
!src/**/*.py
!scripts/
!scripts/**/*.py
!scripts/**/*.sh
!tests/
!tests/**/*.py
!tests/fixtures/
!tests/fixtures/*
!README.md
!STATUS.md
!REPRODUCIBILITY_CHECKLIST.md
!LICENSE
!requirements.txt
!requirements-dev.txt
!Dockerfile
!setup.py


# =============================================================================
# Notes on large file handling
# =============================================================================
#
# The following classes of file will never be committed to this repository:
#
#   - The three external datasets (DS-1, DS-2, DS-3; see STATUS.md §4).
#     Combined these are ~40 GB. They are fetched by data/download_datasets.py
#     with SHA-256 verification against a committed manifest.
#
#   - Any PCAP produced by an attack simulation. These are byproducts, not
#     reference data; every result that depends on them is reproducible from
#     configs/attack_suite_params.yaml.
#
#   - Any file larger than 50 MB, by GitHub's soft limit. The expected
#     outputs are all under 5 MB in total (the two PNG figures dominate).
#     If a future artifact addition needs a larger committed binary, use
#     Git LFS via .gitattributes, not a .gitignore exception.
#
# =============================================================================
